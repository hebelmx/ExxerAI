<Project>
  <PropertyGroup>
    <!-- Redirect all build outputs to artifacts/bin and artifacts/obj -->
    <BaseOutputPath>$(SolutionDir)artifacts\bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(SolutionDir)artifacts\obj\</BaseIntermediateOutputPath>
    <!-- Redirect all test results to artifacts/TestResults -->
    <TestResultsDirectory>$(SolutionDir)artifacts\TestResults\</TestResultsDirectory>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <InformationalVersion>1.0.0+build</InformationalVersion>
  </PropertyGroup>
</Project> 