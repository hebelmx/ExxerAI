def walk_directory(base_path):
    for root, dirs, files in os.walk(base_path):
        dirs[:] = [d for d in dirs if d.lower() not in skip_dirs]
        for file in files:
            if file.lower().endswith('.cs'):
                process_file_independent_fixed(os.path.join(root, file))
def write_clear_report():
    with open(REPORT_PATH, 'w', encoding='utf-8') as f:
        total_changes = 0
        affected_files = set()

        for entry in report_entries:
            f.write(f"\n=== File: {entry['file']} ===\n")
            f.write(f"Lines {entry['start']} to {entry['end']}\n")
            f.write(f"{'-'*80}\n")
            max_len = max(len(entry['before']), len(entry['after']))
            before_lines = entry['before']
            after_lines = entry['after']

            for i in range(max_len):
                before_line = before_lines[i].rstrip('\n') if i < len(before_lines) else ""
                after_line = after_lines[i].rstrip('\n') if i < len(after_lines) else ""
                f.write(f"{before_line:<80} | {after_line}\n")

            f.write(f"{'='*80}\n")
            affected_files.add(entry['file'])
            total_changes += 1

        f.write(f"\nSUMMARY:\nTotal Regions Converted: {total_changes}\nTotal Files Affected: {len(affected_files)}\n")


def write_sequential_report():
    with open(REPORT_PATH, 'w', encoding='utf-8') as f:
        total_changes = 0
        affected_files = set()

        for entry in report_entries:
            f.write(f"\n=== File: {entry['file']} ===\n")
            f.write(f"Lines {entry['start']} to {entry['end']}\n")
            f.write(f"{'-'*80}\n")

            f.write(">>> BEFORE <<<\n")
            f.writelines(entry['before'])
            f.write(f"\n{'-'*80}\n")

            f.write(">>> AFTER <<<\n")
            f.writelines(line + '\n' for line in entry['after'])
            f.write(f"\n{'='*80}\n")

            affected_files.add(entry['file'])
            total_changes += 1

        f.write(f"\nSUMMARY:\nTotal Regions Converted: {total_changes}\nTotal Files Affected: {len(affected_files)}\n")

write_sequential_report()
