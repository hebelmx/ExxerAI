                'end': i + 1,
                'before': context_before + [line] + context_after,
                'after': context_before + [c + '\n' for c in comment_block] + context_after
            })

            if not DRY_RUN:
                output_lines.extend(context_before)
                output_lines.extend([c + '\n' for c in comment_block])
                output_lines.extend(context_after)
                i += len(context_after)
                modified = True
            else:
                output_lines.append(line)
                i += 1

        else:
            output_lines.append(line)
            i += 1

    if modified:
        with open(filepath, 'w', encoding='utf-8') as f:
            f.writelines(output_lines)

