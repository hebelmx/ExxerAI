DRY_RUN = False  #Set to False to apply changes

# Region patterns
region_start_pattern = re.compile(r'^\s*#region\s+(.*)', re.IGNORECASE)
region_end_pattern = re.compile(r'^\s*#endregion(?:\s+(.*))?', re.IGNORECASE)
skip_dirs = {'bin', 'obj', '.vs', '.git'}

# Placeholder for the results
report_entries = []

def sanitize_name(name):
    return name.strip().replace("///", "").replace("<summary>", "").replace("</summary>", "").strip()

def make_summary_comment(text, prefix=""):
    clean = sanitize_name(text)
    return [f"/// <summary>", f"/// {prefix}{clean}", f"/// </summary>", "/// <returns></returns>"]

def process_file(filepath):
    with open(filepath, 'r', encoding='utf-8') as f:
        lines = f.readlines()

    modified = False
    output_lines = []
    i = 0
    changes = []

    while i < len(lines):
        match_start = region_start_pattern.match(lines[i])
        if match_start:
            region_name = match_start.group(1).strip()
            start_index = i
            i += 1
            region_body = []

            while i < len(lines) and not region_end_pattern.match(lines[i]):
                region_body.append(lines[i])
                i += 1

            if i < len(lines):
                end_index = i
                match_end = region_end_pattern.match(lines[i])
                end_region_name = match_end.group(1).strip() if match_end.group(1) else region_name

                before_context = lines[max(0, start_index - 4):start_index]
                after_context = lines[min(len(lines), end_index + 1):min(len(lines), end_index + 5)]

                change_report = {
                    'file': filepath,
                    'start': start_index + 1,
                    'end': end_index + 1,
                    'before': before_context + lines[start_index:end_index + 1] + after_context,
                    'after': before_context +
                             make_summary_comment(region_name, "Begin Tests " if "Test" in region_name else "") +
                             region_body +
                             make_summary_comment(end_region_name, "End Tests " if "Test" in end_region_name else "") +
                             after_context
                }

                report_entries.append(change_report)
                if not DRY_RUN:
                    output_lines.extend(before_context)
                    output_lines.extend(make_summary_comment(region_name, "Begin Tests " if "Test" in region_name else ""))
                    output_lines.extend(region_body)
                    output_lines.extend(make_summary_comment(end_region_name, "End Tests " if "Test" in end_region_name else ""))
                    output_lines.extend(after_context)
                    i = end_index + 1
                    modified = True
                else:
                    output_lines.extend(lines[start_index:end_index + 1])
                    i = end_index + 1
            else:
                i = start_index + 1
        else:
            output_lines.append(lines[i])
            i += 1

    if modified:
        with open(filepath, 'w', encoding='utf-8') as f:
            f.writelines(output_lines)

