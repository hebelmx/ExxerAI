def process_file_independent(filepath):
    with open(filepath, 'r', encoding='utf-8') as f:
        lines = f.readlines()

    modified = False
    output_lines = []
    i = 0

    while i < len(lines):
        line = lines[i]
        match_region = region_start_pattern.match(line)
        match_endregion = region_end_pattern.match(line)

        if match_region:
            region_name = match_region.group(1).strip()
            comment_block = make_summary_comment(region_name, "Begin Tests " if "Test" in region_name else "")
            context_before = lines[max(0, i - 4):i]
            context_after = lines[i + 1:i + 5]

            report_entries.append({
                'file': filepath,
                'start': i + 1,
                'end': i + 1,
                'before': context_before + [line] + context_after,
                'after': context_before + [c + '\n' for c in comment_block] + context_after
            })

            if not DRY_RUN:
                output_lines.extend(context_before)
                output_lines.extend([c + '\n' for c in comment_block])
                output_lines.extend(context_after)
                i += len(context_after)
                modified = True
            else:
                output_lines.append(line)
                i += 1

        elif match_endregion:
            region_name = match_endregion.group(1).strip() if match_endregion.group(1) else "Region"
            comment_block = make_summary_comment(region_name, "End Tests " if "Test" in region_name else "End ")
            context_before = lines[max(0, i - 4):i]
