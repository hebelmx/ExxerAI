<Project Sdk="Microsoft.NET.Sdk">
	<Sdk Name="Aspire.AppHost.Sdk" Version="9.3.1" />
	<PropertyGroup>
	<OutputType>Exe</OutputType>
	<TargetFramework>net10.0</TargetFramework>
	<ImplicitUsings>enable</ImplicitUsings>
	<Nullable>enable</Nullable>
	<IsAspireHost>true</IsAspireHost>
	<UserSecretsId>e99e4025-0fd5-4383-8380-0e1122b49ac5</UserSecretsId>
	
	<!-- Self-contained deployment settings -->
	<PublishSingleFile>true</PublishSingleFile>
	<SelfContained>true</SelfContained>
	<RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
	<PublishTrimmed>false</PublishTrimmed>
	<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
	<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
	
	<!-- Application metadata -->
	<AssemblyTitle>LocalAI Aspire Orchestrator</AssemblyTitle>
	<AssemblyDescription>Self-contained orchestrator for local AI stack using .NET Aspire</AssemblyDescription>
	<AssemblyVersion>1.0.0.0</AssemblyVersion>
	<FileVersion>1.0.0.0</FileVersion>
	<Company>LocalAI</Company>
	<Product>LocalAI Aspire Orchestrator</Product>
  </PropertyGroup>

  <ItemGroup>
	<PackageReference Include="Aspire.Hosting.AppHost" />
	<PackageReference Include="Aspire.Hosting.PostgreSQL" />
	<PackageReference Include="Aspire.Hosting.Redis" />
	<PackageReference Include="Aspire.Hosting.NodeJs" />
	<PackageReference Include="Aspire.Hosting.RabbitMQ" />
	<PackageReference Include="Aspire.Hosting.MongoDB" />
	<PackageReference Include="Microsoft.Extensions.Hosting" />
	<PackageReference Include="Microsoft.Extensions.ServiceDiscovery" />
  </ItemGroup>

  <ItemGroup>
	<ProjectReference Include="..\..\Presentation\ExxerAI.UI.Dashboard\ExxerAI.Aspire.Dashboard.csproj" />
  </ItemGroup>

</Project>
