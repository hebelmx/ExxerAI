<Project>

	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<LangVersion>preview</LangVersion>

		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>

		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
		<GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
		<GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
	</PropertyGroup>
	<PropertyGroup>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<GenerateBuildLog>true</GenerateBuildLog>
		<BinaryLogFile>$(ArtifactsDir)\logs\$(MSBuildProjectName).binlog</BinaryLogFile>
	</PropertyGroup>
	<PropertyGroup>
		<!-- Root where Directory.Build.props is placed -->
		<RepoRoot>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))</RepoRoot>

		<!-- Global output directories -->
		<ArtifactsDir>$([System.IO.Path]::Combine('$(RepoRoot)', 'artifacts'))</ArtifactsDir>
		<ArtifactsObjDir>$([System.IO.Path]::Combine('$(ArtifactsDir)', 'obj'))</ArtifactsObjDir>
		<ArtifactsBinDir>$([System.IO.Path]::Combine('$(ArtifactsDir)', 'bin'))</ArtifactsBinDir>
		<ArtifactsPackagesDir>$([System.IO.Path]::Combine('$(ArtifactsDir)', 'packages', '$(Configuration)'))</ArtifactsPackagesDir>
		<ArtifactsTestResultsDir>$([System.IO.Path]::Combine('$(ArtifactsDir)', 'TestResults', '$(Configuration)'))</ArtifactsTestResultsDir>

		<!-- Use project name as folder -->
		<OutDirName>$(MSBuildProjectName)</OutDirName>

		<!-- Enforced centralized build outputs -->
		<BaseIntermediateOutputPath>$([System.IO.Path]::Combine('$(ArtifactsObjDir)', '$(OutDirName)'))\\</BaseIntermediateOutputPath>
		<IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)\\</IntermediateOutputPath>

		<BaseOutputPath>$([System.IO.Path]::Combine('$(ArtifactsBinDir)', '$(OutDirName)'))\\</BaseOutputPath>

		<PackageOutputPath>$(ArtifactsPackagesDir)</PackageOutputPath>
	</PropertyGroup>

	<PropertyGroup>
		<VSTestLogger Condition="'$(VSTestLogger)' == ''">trx%3bLogFileName=$(MSBuildProjectName).$(TargetFramework).$(OS).trx</VSTestLogger>
		<VSTestResultsDirectory Condition="'$(VSTestResultsDirectory)' == ''">$(ArtifactsTestResultsDir)</VSTestResultsDirectory>
	</PropertyGroup>

	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<!-- Exclude AppHost project when EXCLUDE_APPHOST is set -->
	<PropertyGroup Condition="'$(EXCLUDE_APPHOST)' == 'true' AND '$(MSBuildProjectName)' == 'ExxerAI.Aspire.AppHost'">
		<IsPublishable>false</IsPublishable>
		<IsPackable>false</IsPackable>
		<IsTestProject>false</IsTestProject>
		<ExcludeFromBuild>true</ExcludeFromBuild>
	</PropertyGroup>
</Project>