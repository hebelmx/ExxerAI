    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="9.0.6" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.6" />
    <!-- Utilities -->
    <PackageVersion Include="FluentResults" Version="4.0.0" />
    <PackageVersion Include="FluentValidation" Version="11.12.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.12.0" />
    <PackageVersion Include="DotNet.ReproducibleBuilds" Version="1.2.25" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <!-- Testing - XUnit V3 Latest Stable -->
    <PackageVersion Include="xunit.v3" Version="3.0.0-pre.25" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.1" />
    <PackageVersion Include="xunit.analyzers" Version="1.23.0-pre.3" />
    <!--Testin Architecture-->
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <!-- Testing - XUnit v2.9.3 Latest Stable Migrated 4-Jul-2025-->
    <!--<PackageVersion Include="xunit" Version="2.9.3" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="3.1.1" />
		<PackageVersion Include="xunit.analyzers" Version="1.18.0" />-->
    <!--Testin Infraestructure-->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="coverlet.msbuild" Version="6.0.2" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Meziantou.Extensions.Logging.Xunit.v3" Version="1.1.6" />
    <PackageVersion Include="FakeClock" Version="1.1.1" />
    <!-- System -->
    <PackageVersion Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageVersion Include="System.Net.ServerSentEvents" Version="10.0.0-preview.4.25258.110" />
    <PackageVersion Include="System.IO.Pipelines" Version="9.0.6" />
    <PackageVersion Include="Microsoft.Bcl.Memory" Version="4.5.5" />
