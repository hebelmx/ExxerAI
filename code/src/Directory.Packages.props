<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!---->
    <PackageVersion Include="DiffEngine" Version="16.2.3" />
    <PackageVersion Include="FluentAssertions" Version="8.4.0" />
    <!-- ASP.NET Core and Web -->
    <PackageVersion Include="Microsoft.AspNetCore.Diagnostics.EntityFrameworkCore" Version="9.0.6" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.6" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.6" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="9.0.1" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.6" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.6" />
    <!-- UI Framework -->
    <PackageVersion Include="MudBlazor" Version="8.8.0" />
    <PackageVersion Include="Extensions.MudBlazor.StaticInput" Version="3.2.0" />
    <!-- AI and Extensions -->
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.6" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.6" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="9.0.6" />
    <!-- Entity Framework -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.6" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.5" />
    <PackageVersion Include="EntityFrameworkCore.Testing" Version="2.4.0" />
    <PackageVersion Include="MockQueryable.EntityFrameworkCore" Version="7.0.4" />
    <!-- Google APIs -->
    <PackageVersion Include="Google.Apis.Drive.v3" Version="1.69.0.3783" />
    <PackageVersion Include="Google.Apis.Auth" Version="1.70.0" />
    <PackageVersion Include="Google.Apis.Core" Version="1.70.0" />
    <!-- Document Processing -->
    <PackageVersion Include="PdfPig" Version="0.1.10" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.10" />
    <!-- Machine Learning -->
    <PackageVersion Include="Microsoft.ML" Version="4.0.0" />
    <!-- Serilog Logging -->
    <PackageVersion Include="Serilog" Version="4.3.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
