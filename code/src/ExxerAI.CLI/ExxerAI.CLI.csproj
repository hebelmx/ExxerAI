<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============================================================================ -->
  <!-- CORE PROPERTIES -->
  <!-- ============================================================================ -->
  <PropertyGroup>
    <!-- Target Framework -->
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    
    <!-- Language Features -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Application Information -->
    <AssemblyTitle>ExxerAI Command Line Interface</AssemblyTitle>
    <Description>ExxerAI Intelligence System CLI Tool</Description>
    <Company>Exxerpro Solutions</Company>
    <Product>ExxerAI Intelligence System</Product>
    <Title>ExxerAI.CLI</Title>
  </PropertyGroup>

  <!-- ============================================================================ -->
  <!-- PUBLISHING PROPERTIES -->
  <!-- ============================================================================ -->
  <PropertyGroup>
    <!-- Publishing Enhancements -->
    <EnableDynamicPgo>true</EnableDynamicPgo>
    <TieredCompilation>true</TieredCompilation>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <!-- ============================================================================ -->
  <!-- PACKAGE REFERENCES - CORE FRAMEWORK -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Core Framework">
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <!-- ============================================================================ -->
  <!-- PROJECT REFERENCES -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Infrastructure References">
    <ProjectReference Include="../ExxerAI.Domain/ExxerAI.Domain.csproj" />
    <ProjectReference Include="../ExxerAI.Application/ExxerAI.Application.csproj" />
    <ProjectReference Include="../ExxerAI.Infrastructure/ExxerAI.Infrastructure.csproj" />
  </ItemGroup>

</Project>
