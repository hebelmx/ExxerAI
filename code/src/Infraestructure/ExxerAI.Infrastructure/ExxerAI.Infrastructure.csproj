<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============================================================================ -->
  <!-- CORE PROPERTIES -->
  <!-- ============================================================================ -->
  <PropertyGroup>
    <!-- Target Framework Defined on Build.Props Do to Add Another here-->
    
	  <TreatWarningsAsErrors>false</TreatWarningsAsErrors>

    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Language Features -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Package Management -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>false</RestoreLockedMode>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DisablePackageRestore>false</DisablePackageRestore>


  </PropertyGroup>

  <!-- ============================================================================ -->
  <!-- PUBLISHING PROPERTIES -->
  <!-- ============================================================================ -->
  <PropertyGroup>
    <!-- Publishing Enhancements -->
    <EnableDynamicPgo>true</EnableDynamicPgo>
    <TieredCompilation>true</TieredCompilation>
  </PropertyGroup>

  <!-- ============================================================================ -->
  <!-- PACKAGE REFERENCES - CORE FRAMEWORK -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Core Framework">
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="FluentResults" />
  </ItemGroup>

  <!-- ============================================================================ -->
  <!-- PACKAGE REFERENCES - GOOGLE APIS -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Google APIs">
    <PackageReference Include="Google.Apis.Auth" />
    <PackageReference Include="Google.Apis.Drive.v3" />
    <PackageReference Include="Google.Apis.Core" />
  </ItemGroup>

  <!-- ============================================================================ -->
  <!-- PACKAGE REFERENCES - DOCUMENT PROCESSING -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Document Processing">
    <PackageReference Include="PdfPig" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Core\ExxerAI.Application\ExxerAI.Application.csproj" />
    <ProjectReference Include="..\..\Core\ExxerAI.Domain\ExxerAI.Domain.csproj" />
  </ItemGroup>

  <!-- ============================================================================ -->
  <!-- PACKAGE REFERENCES - VECTOR DATABASE -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Vector Database">
    <PackageReference Include="Qdrant.Client" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
  </ItemGroup>

  <!-- ============================================================================ -->
  <!-- PACKAGE REFERENCES - GRAPH DATABASE -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Graph Database">
    <PackageReference Include="Neo4jClient" />
    <PackageReference Include="Graphr.Neo4j" />
  </ItemGroup>

  <!-- ============================================================================ -->
  <!-- PROJECT REFERENCES -->
  <!-- ============================================================================ -->

</Project>
