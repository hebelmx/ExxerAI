  "McpSettings": {
    "Enabled": true,
    "Servers": [
      {
        "Name": "GoogleDrive",
        "Command": "npx",
        "Args": ["@anthropic/google-drive-mcp"],
        "Environment": {
          "GOOGLE_APPLICATION_CREDENTIALS": "./credentials/google-credentials.json"
        },
        "AutoConnect": true
      },
      {
        "Name": "FileSystem",
        "Command": "npx", 
        "Args": ["@anthropic/filesystem-mcp"],
        "Environment": {
          "FILESYSTEM_ALLOWED_PATHS": "/app/data,/app/documents"
        },
        "AutoConnect": true
      },
      {
        "Name": "WebSearch",
        "Command": "npx",
        "Args": ["@anthropic/web-search-mcp"],
        "Environment": {
          "SEARCH_API_KEY": "${SEARCH_API_KEY}"
        },
        "AutoConnect": false
      }
    ]
  },

  "ApiSettings": {
    "BaseUrl": "https://exxerai.company.com",
    "Version": "v1",
    "EnableSwagger": true,
    "EnableCors": true,
    "AllowedOrigins": [
      "https://exxerai.company.com",
      "http://localhost:3000",
      "http://localhost:7003"
    ]
  },

  "Security": {
    "JwtSettings": {
      "SecretKey": "${JWT_SECRET_KEY}",
      "Issuer": "ExxerAI",
      "Audience": "ExxerAI-Users",
      "ExpirationMinutes": 1440
    },
    "ApiKeys": {
      "AdminKey": "${ADMIN_API_KEY}",
      "AutonomousKey": "${AUTONOMOUS_API_KEY}"
    }
  },

  "Performance": {
    "EnableResponseCaching": true,
    "CacheDurationMinutes": 30,
    "EnableCompression": true,
    "MaxConcurrentRequests": 100,
    "RequestTimeoutSeconds": 300
  },

  "Monitoring": {
    "EnableHealthChecks": true,
    "EnableMetrics": true,
    "HealthCheckIntervalSeconds": 30,
    "MetricsRetentionDays": 30
  },

  "AllowedHosts": "*"
} 