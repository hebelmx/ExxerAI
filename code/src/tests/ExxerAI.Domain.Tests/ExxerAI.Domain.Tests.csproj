<Project Sdk="Microsoft.NET.Sdk">

	<!-- ============================================================================ -->
	<!-- CORE PROPERTIES -->
	<!-- ============================================================================ -->
	<PropertyGroup>
		<!-- Target Framework -->
		<!-- XUnit v3 Configuration: Test projects are now executables -->
		<OutputType>Exe</OutputType>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>

		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
		<!-- Language Features -->
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseAppHost>true</UseAppHost>
		<!-- ensures an actual executable is generated -->




		<IsTestProject>true</IsTestProject>

		<!-- Application Information -->
		<AssemblyTitle>ExxerAI Domain Tests</AssemblyTitle>
		<Description>Unit Tests for ExxerAI Domain Entities and Business Logic</Description>
		<Company>Exxerpro Solutions</Company>
		<Product>ExxerAI Intelligence System</Product>
		<Title>ExxerAI.Domain.Tests</Title>
	</PropertyGroup>

	<!-- ============================================================================ -->
	<!-- PUBLISHING PROPERTIES -->
	<!-- ============================================================================ -->
	<PropertyGroup>
		<!-- Publishing Enhancements -->
		<EnableDynamicPgo>true</EnableDynamicPgo>
		<TieredCompilation>true</TieredCompilation>
	</PropertyGroup>
	<!-- Directory.Build.props or project file -->

	<PropertyGroup>
		<!-- Ensures all assemblies from NuGet are copied to output -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<RunSettingsFilePath>F:\Dynamic\ExxerAi\ExxerAI\code\src\artifacts\bin\ExxerAI.Domain.Tests\Debug\net9.0\fine-code-coverage\coverage-tool-output\ExxerAI.Domain.Tests-fcc-mscodecoverage-generated.runsettings</RunSettingsFilePath>
	</PropertyGroup>
	<!-- HACK_WARNING_DO_NOT_AUTOMATE_THIS -->

	<Target Name="ForceCopyDiffEngine" AfterTargets="Build">
		<ItemGroup>
			<DiffEngineDll Include="$(NuGetPackageRoot)diffengine\16.2.3\lib\net9.0\DiffEngine.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(DiffEngineDll)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="false" OverwriteReadOnlyFiles="true" />
	</Target>

	<!-- ============================================================================ -->
	<!-- PACKAGE REFERENCES - TESTING FRAMEWORK (XUnit v3) -->
	<!-- ============================================================================ -->
	<ItemGroup Label="Testing Framework">
		

		<PackageReference Include="xunit.v3" />
		<PackageReference Include="xunit.analyzers">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="xunit.runner.visualstudio">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<PackageReference Include="xunit.v3.runner.inproc.console" />

	

		<PackageReference Include="coverlet.collector" />
		</ItemGroup>

	<!-- ============================================================================ -->
	<!-- PACKAGE REFERENCES - TESTING UTILITIES -->
	<!-- ============================================================================ -->
	<ItemGroup Label="Testing Utilities">
		<PackageReference Include="Shouldly" />
	</ItemGroup>

	<!-- ============================================================================ -->
	<!-- GLOBAL USINGS -->
	<!-- ============================================================================ -->
	<ItemGroup Label="Global Usings">
		<Using Include="Xunit" />
	</ItemGroup>

	<!-- ============================================================================ -->
	<!-- ALWAYS INCLUDE xunit.runner.json-->
	<!-- ============================================================================ -->


	<ItemGroup>
		<Content Include="testconfig.json">
		  <CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

	<!-- ============================================================================ -->
	<!-- PROJECT REFERENCES -->
	<!-- ============================================================================ -->
	<ItemGroup Label="Infrastructure References">
		<ProjectReference Include="..\..\Core\ExxerAI.Domain\ExxerAI.Domain.csproj" />

	</ItemGroup>
	<ItemGroup>
	  <None Update="xunit.runner.json">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
