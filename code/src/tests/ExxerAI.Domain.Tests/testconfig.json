{
  "xUnit": {
    "diagnosticMessages": true, // Enables internal xUnit diagnostics (good for troubleshooting)
    "culture": "en-US", // Sets default test culture
    "parallelizeTestCollections": true, // Allows collection-level test parallelism
    "parallelizeAssembly": false, // Prevents test assemblies from running in parallel
    "maxParallelThreads": 4, // Limits concurrency to 4 threads (0 = auto)
    "longRunningTestSeconds": 60 // Flags tests taking more than 60s
  }
}