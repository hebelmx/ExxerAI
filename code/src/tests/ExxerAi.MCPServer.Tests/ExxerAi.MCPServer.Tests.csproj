<Project Sdk="Microsoft.NET.Sdk">

  <!-- ============================================================================ -->
  <!-- CORE PROPERTIES -->
  <!-- ============================================================================ -->
  <PropertyGroup>
    <!-- Target Framework -->
    <TargetFramework>net9.0</TargetFramework>
    
    <!-- Language Features -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- Test Configuration -->
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    
    <!-- Application Information -->
    <AssemblyTitle>ExxerAI MCP Server Tests</AssemblyTitle>
    <Description>Unit Tests for ExxerAI Model Context Protocol Server</Description>
    <Company>Exxerpro Solutions</Company>
    <Product>ExxerAI Intelligence System</Product>
    <Title>ExxerAi.MCPServer.Tests</Title>
  </PropertyGroup>

  <!-- ============================================================================ -->
  <!-- PUBLISHING PROPERTIES -->
  <!-- ============================================================================ -->
  <PropertyGroup>
    <!-- Publishing Enhancements -->
    <EnableDynamicPgo>true</EnableDynamicPgo>
    <TieredCompilation>true</TieredCompilation>
  </PropertyGroup>

  <!-- ============================================================================ -->
  <!-- PACKAGE REFERENCES - TESTING FRAMEWORK -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Testing Framework">
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
          <PackageReference Include="xunit.v3" />
            <PackageReference Include="xunit.analyzers">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      </PackageReference>
      <PackageReference Include="xunit.runner.visualstudio">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
      </PackageReference>
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <!-- ============================================================================ -->
  <!-- PACKAGE REFERENCES - TESTING UTILITIES -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Testing Utilities">
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <!-- ============================================================================ -->
  <!-- GLOBAL USINGS -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Global Usings">
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- ============================================================================ -->
  <!-- PROJECT REFERENCES -->
  <!-- ============================================================================ -->
  <ItemGroup Label="Infrastructure References">
    <ProjectReference Include="..\..\Infraestructure\ExxerAi.MCPServer\ExxerAi.MCPServer.csproj" />
  </ItemGroup>

</Project> 