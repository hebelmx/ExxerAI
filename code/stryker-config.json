{
  "stryker-config": {
    "project": "ExxerAI.sln",
    "test-projects": [
      "tests/ExxerAI.Application.Tests/ExxerAI.Application.Tests.csproj",
      "tests/ExxerAI.Domain.Tests/ExxerAI.Domain.Tests.csproj",
      "tests/ExxerAI.Infrastructure.Tests/ExxerAI.Infrastructure.Tests.csproj",
      "tests/ExxerAI.Api.Tests/ExxerAI.Api.Tests.csproj",
      "tests/ExxerAI.CLI.Tests/ExxerAI.CLI.Tests.csproj",
      "tests/ExxerAI.Orchestration.Tests/ExxerAI.Orchestration.Tests.csproj",
      "tests/ExxerAi.MCPServer.Tests/ExxerAi.MCPServer.Tests.csproj"
    ],
    "mutate": [
      "ExxerAI.Application/**/*.cs",
      "ExxerAI.Domain/**/*.cs", 
      "ExxerAI.Infrastructure/**/*.cs",
      "ExxerAI.Api/**/*.cs",
      "ExxerAI.CLI/**/*.cs",
      "ExxerAI.Orchestration/**/*.cs",
      "ExxerAI.UI/**/*.cs",
      "ExxerAi.MCPServer/**/*.cs",
      "!**/*Tests.cs",
      "!**/*Test.cs", 
      "!**/bin/**",
      "!**/obj/**",
      "!**/*.Designer.cs",
      "!**/*.g.cs",
      "!**/*.g.i.cs",
      "!**/AssemblyInfo.cs",
      "!**/GlobalUsings.cs",
      "!**/Program.cs"
    ],
    "ignore-methods": [
      "LogDebug",
      "LogInformation", 
      "LogWarning",
      "LogError",
      "LogCritical",
      "LogTrace",
      "*Log*Debug*",
      "*Log*Information*", 
      "*Log*Warning*",
      "*Log*Error*",
      "*Log*Critical*",
      "*Log*Trace*",
      "*Task.Delay*",
      "*ArgumentNullException*",
      "*ArgumentException*"
    ],
    "ignore-mutations": [
      "String"
    ],
    "mutation-level": "Standard",
    "thresholds": {
      "high": 85,
      "low": 70,
      "break": 60
    },
         "reporters": ["html", "progress", "json"],
     "verbosity": "info",
     "concurrency": 6,
     "disable-bail": false,
     "break-on-initial-test-failure": false,
     "report-file-name": "mutation-report",
     "json": {
       "enabled": true
     }
  }
} 