<Project Sdk="Microsoft.NET.Sdk">

  <!-- 
    ===============================================================================
    ExxerAI.Infrastructure.Tests - Infrastructure Integration Tests
    ===============================================================================
    Purpose: Integration tests for external adapters and implementations
    Dependencies: All layers, testing framework, test containers
    Architecture: Real implementation testing with external dependencies
    ===============================================================================
  -->
  <!-- ============================================================================ -->
  <!-- CORE PROPERTIES -->
  <!-- ============================================================================ -->
  <PropertyGroup>
	  <!-- Target Framework -->
	  <TargetFramework>.net10.0</TargetFramework>
	  <OutputType>Exe</OutputType>
	  <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
	  <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
	  <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
	  <TestingPlatformServer>true</TestingPlatformServer>
	  <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	  <!-- Language Features -->
	  <Nullable>enable</Nullable>


	  <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <PropertyGroup Label="Project Configuration">
    <AssemblyName>ExxerAI.Infrastructure.Tests</AssemblyName>
    <RootNamespace>ExxerAI.Infrastructure.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <PropertyGroup Label="Version Management">
	  <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Project References">
    <ProjectReference Include="..\..\..\src\ExxerAI.Domain\ExxerAI.Domain.csproj" />
    <ProjectReference Include="..\..\..\src\ExxerAI.Application\ExxerAI.Application.csproj" />
    <ProjectReference Include="..\..\..\src\ExxerAI.Infrastructure\ExxerAI.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup Label="Testing Framework">
	  <PackageReference Include="xunit.v3" />
	  <PackageReference Include="xunit.runner.visualstudio">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
	  </PackageReference>

	  <PackageReference Include="Shouldly"  />
	  <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup Label="Framework Dependencies">
	  <PackageReference Include="Microsoft.Extensions.DependencyInjection"  />
	  <PackageReference Include="Microsoft.Extensions.Logging"  />
  </ItemGroup>

  <ItemGroup Label="Testing Infrastructure">
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />

  </ItemGroup>

</Project> 